---
import WineCard from '../WineCard.astro';
import { byKey } from '../../commerce';
import { bf, type Block } from '../../cms/blocks.mjs';
const { b } = Astro.props as { b: Block };
const heading = bf(b, 'heading');
const wines = ((bf(b, 'wines') as string[] | undefined) ?? []).map((k) => byKey(String(k))).filter(Boolean) as NonNullable<ReturnType<typeof byKey>>[];
---
{wines.length > 0 && (
  <section class="section wrap">
    {heading && <div class="section-head"><h2 class="caps">{heading}</h2></div>}
    <div class="wine-grid">{wines.map((w) => <WineCard wine={w} />)}</div>
  </section>
)}
