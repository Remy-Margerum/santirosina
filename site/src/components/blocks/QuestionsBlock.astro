---
import { bf, br, type Block } from '../../cms/blocks.mjs';
const { b } = Astro.props as { b: Block };
const heading = bf(b, 'heading') || 'Questions';
const items = ((bf(b, 'items') as any[]) || []).map((it, i) => ({ q: String(it?.question || ''), a: String(((br(b, 'items') as any[]) || [])[i]?.answer || '') })).filter((x) => x.q);
---
{items.length > 0 && (
  <section class="wrap text-block questions">
    <div class="measure col">
      <h2 class="caps">{heading}</h2>
      {items.map((x) => <details><summary>{x.q}</summary><div class="copy" set:html={x.a} /></details>)}
    </div>
  </section>
)}
