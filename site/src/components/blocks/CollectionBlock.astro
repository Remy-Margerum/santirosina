---
// The collection (home): every wine of the catalog, one card each (its picture, vintage and name, linking to its page),
// three to a row. Built from the catalog. The approved copy's line for a wine is on that wine's page: under three of
// nine cards it would stand the row unevenly (2026-09-29, the 2026 program's nine wines).
import WineCard from '../WineCard.astro';
import { wineGroups } from '../../commerce';
import { bf, br, type Block } from '../../cms/blocks.mjs';
const { b } = Astro.props as { b: Block };
const heading = bf(b, 'heading') || 'The Collection';
const intro = br(b, 'intro');
const wines = wineGroups().map((g) => g.items[0]);
---
{wines.length > 0 && (
  <section class="collection">
    <div class="wrap">
      <div class="section-head">
        <h2 class="caps">{heading}</h2>
        {intro && <div class="copy measure col lede" set:html={intro} />}
      </div>
      <div class="wine-grid wine-grid--three">{wines.map((w) => <WineCard wine={w} />)}</div>
    </div>
  </section>
)}
