---
// One wine: its picture on the cream panel, the vintage, the wine's name in the label's capitals, the price and the
// buy slot when the shop shows them (hidden today: no price, no button).
import WineArt from './WineArt.astro';
import ShopSlot from '../commerce/ShopSlot.astro';
import { priceOf } from '../commerce';
import type { CatalogItem } from '../commerce/provider';
import { u } from '../lib/url';
interface Props { wine: CatalogItem; headingLevel?: 'h2' | 'h3' }
const { wine, headingLevel = 'h3' } = Astro.props;
const href = u(`/wines/${wine.slug}/`);
const H = headingLevel;
const price = priceOf(wine);
---
<article class="wine-card">
  <a class="wine-card__art" href={href} tabindex="-1" aria-hidden="true"><WineArt wine={wine} sizes="(max-width: 600px) 45vw, 160px" alt="" /></a>
  <div class="wine-card__body">
    <span class="wine-card__vintage">{wine.vintage ?? 'NV'}</span>
    <H class="wine-card__name"><a href={href}><span class="sr-only">{wine.vintage} </span>{wine.name}</a></H>
    {price && <span class="price">{price}</span>}
    <ShopSlot kind="buy" sku={wine.key} />
  </div>
</article>
